generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // Administrador da plataforma — acesso global, todas as empresas
  COMPANY_MASTER // Administrador da empresa — escopo total dentro da empresa
  COMPANY_GERENTE // Gestão operacional (ponto, checklists, mural, advertências)
  COMPANY_FINANCE // Financeiro — saques PIX, aprovação de comissões
  EMPLOYEE // Operador de linha de frente (scanner, ponto, checklists)
  PARTNER // Pessoa física ou agência (PJ) que indica clientes
}

enum PartnerType {
  INDIVIDUAL // Pessoa física
  AGENCY // Pessoa jurídica (agência de turismo) — pode ter colaboradores/guias
}

enum Status {
  ACTIVE
  INACTIVE
}

// Solicitação de exclusão/arquivamento de conta feita pelo próprio usuário
// (botão obrigatório em /partner/perfil e /company/perfil — regra Apple App
// Store Guideline 5.1.1(v) + LGPD). Fica pendente até um Admin revisar e
// desativar a conta manualmente (ver notifyPlatformAdmins em lib/notifications.ts).
enum AccountDeletionStatus {
  NONE
  ACCOUNT_DELETION_REQUESTED
}

enum CommissionType {
  FIXED
  VARIABLE
  BOTH // % (Program.commissionValue) + valor fixo (Program.fixedValue) simultâneos
}

enum ReferralStatus {
  PENDING
  VISITED
  NOT_VISITED
}

enum CommissionStatus {
  AWAITING_VALUE
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum WalletTransactionType {
  COMMISSION
  WITHDRAWAL
  MANUAL_CREDIT
  MANUAL_DEBIT
}

enum WalletTransactionStatus {
  COMPLETED
  PENDING
}

enum TimeEntryType {
  CHECK_IN
  BREAK_START
  BREAK_END
  CHECK_OUT
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostStatus {
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
}

enum OccurrenceType {
  FOLGA_FERIADO // Folga ou feriado (trabalhado ou de descanso)
  VALE // Vale/Adiantamento
  CONSUMO // Comanda assinada na casa — vira dívida em User.consumptionDebt (ver PAGAMENTO_CONSUMO)
  QUEBRA_CAIXA // Quebra de caixa — desconto por diferença no fechamento do caixa, não mexe na Conta de Consumo
  PAGAMENTO_CONSUMO // Pagamento (dinheiro/PIX) recebido do colaborador abatendo a Conta de Consumo
  META // Bonificação por meta batida
  FALTA // Falta — sem ATESTADO em 24h gera abate de 1 dia (ver discountWaived)
  ATESTADO // Atestado médico — exige attachmentUrl; abona uma FALTA do mesmo dia em até 24h
  ADVERTENCIA // Advertência — exige attachmentUrl (documento assinado)
  SUSPENSAO // Suspensão
  DIARIA // Diária de colaborador temporário/freelancer (frequentemente sem cadastro)
  HORA_EXTRA // Hora extra trabalhada
  BANCO_HORAS // Lançamento no banco de horas
  DISPENSADO // Desligamento — exige attachmentUrl
  FIXADO // Efetivação/fixação do colaborador
  CUSTOM // Tipo configurável pela empresa — ver Occurrence.customTypeId / OccurrenceTypeConfig
}

// Natureza do impacto de um tipo de ocorrência configurável pela empresa (ver OccurrenceTypeConfig).
enum OccurrenceImpactKind {
  POINTS // Ganho ou perda de Pontos (Pts) no Programa Interno
  SALARY // Desconto ou bônus no Salário/Taxa de Serviço
  HOURS_BANK // Abatimento ou crédito no Banco de Horas
  INFORMATIONAL // Sem impacto financeiro ou de pontos — só registro
}

enum OccurrenceSalaryImpactType {
  DISCOUNT
  BONUS
}

enum OccurrencePaymentMethod {
  DINHEIRO
  PIX
  TRABALHO
  FOLGA_ADICIONAL
  CONSUMO // abate diretamente da Conta de Consumo (User.consumptionDebt) do colaborador — não é dinheiro novo saindo
}

enum OccurrencePaymentStatus {
  PENDING
  PAID
}

enum ShiftClosingStatus {
  PENDING_GERENTE
  PENDING_MASTER // Gerente perdeu o horário limite — transbordou para o Master
  COMPLETED
}

enum XpReason {
  ATTENDANCE
  CHECKLIST_ON_TIME
  CHECKLIST_EXTRA_TASK // secundário ajudou numa tarefa já coberta pelo principal presente — bônus, não substitui a nota do principal
  DAILY_EVALUATION
  OCCURRENCE_PENALTY
  MANUAL_ADJUSTMENT
  REWARD_REDEMPTION
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

// PENDING = instancia do dia criada, colaborador ainda nao entregou.
// SUBMITTED = colaborador entregou (com foto se exigido), aguardando o double-check da Gerente.
// APPROVED = Gerente confirmou — credita XP.
// RETURNED = Gerente devolveu para o colaborador refazer, com observacao.
// REJECTED = "nao entregue" — prazo estourado ou marcado manualmente, penaliza XP.
enum ChecklistStatus {
  PENDING
  SUBMITTED
  APPROVED
  RETURNED
  REJECTED
}

enum ChecklistRecurrence {
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  BIMONTHLY
  TRIMONTHLY
  SEMIANNUAL
  ANNUAL
}

enum ChecklistPriority {
  LOW
  MEDIUM
  HIGH
}

enum RegistrationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  RESOLVED
}

enum MeasurementPeriod {
  MONTHLY
  BIMONTHLY
  SEMIANNUAL
  ANNUAL
}

enum ShiftType {
  DAY
  NIGHT
}

enum GoalScope {
  COMPANY
  SECTOR
  EMPLOYEE
}

enum GoalPeriod {
  DAILY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

// Tipo de recompensa de uma faixa de Meta (GoalTier) — CASH credita
// bonusAmount na carteira; PHYSICAL_REWARD concede um item da Loja de
// Prêmios (rewardCatalogItemId) ou um prêmio livre (rewardLabel), sem
// impacto financeiro direto (ver app/company/metas e Financeiro).
enum GoalRewardType {
  CASH
  PHYSICAL_REWARD
}

// Status de quitação de um bônus/prêmio de Meta atingida — registrado pela
// Gerente/Master no Módulo Financeiro (ver model GoalPayout).
enum GoalPayoutStatus {
  PENDING
  PAID
}

// Destinatário de uma Comunicação Interna — SECTOR usa recipientSectorId
// (entregue aos responsáveis do setor, ver EmployeeProfile.
// isSectorCommunicationResponsible), ROLE usa recipientRole, EMPLOYEE usa
// recipientEmployeeId.
enum InternalMessageRecipientType {
  SECTOR
  ROLE
  EMPLOYEE
}

enum InternalMessageStatus {
  SENT
  PENDING_RESPONSE
  RESPONDED
  CONCLUDED
}

// Formato do valor de comissão de um Program — substitui o antigo campo
// booleano `isPercentage`, que não conseguia representar bonificação em
// unidade de produto (ex: "1 diária grátis").
enum CommissionFormat {
  PERCENTAGE // commissionValue é uma % sobre a comanda
  FIXED_VALUE // commissionValue é um valor fixo em R$
  PRODUCT_UNIT // bonificação em unidade de produto/serviço (ver productUnitLabel)
}

enum PromotionOfferType {
  DISCOUNT // Desconto sobre o valor real
  FREE_GIFT // Brinde gratuito
  DOUBLE_BENEFIT // "Pediu 1, levou 2"
  CASH_CREDIT // Crédito em dinheiro na comanda (ver Promotion.creditAmount)
}

// Público da promoção — EXTERNAL aparece para todos os Parceiros da plataforma
// (comportamento histórico); INTERNAL fica reservada para o Colaborador
// oferecer diretamente ao cliente no balcão (ex: Vale Retorno), sem depender
// de indicação de Parceiro.
enum PromotionAudience {
  EXTERNAL
  INTERNAL
}

enum PromotionVoucherStatus {
  PENDING
  REDEEMED
  EXPIRED
  CANCELED
}

enum AffiliatePayoutType {
  SIGNUP_BONUS // pago quando um parceiro indicado é aprovado
  MILESTONE_BONUS // pago quando o parceiro indicado atinge milestoneClientCount clientes convertidos (ou um AffiliateMilestone)
  RECURRING_COMMISSION // rewardType = PERCENTAGE_RECURRING — % sobre comissões/mensalidades correntes (ver periodKey)
}

enum AffiliatePayoutStatus {
  PENDING
  PAID
}

enum AffiliateRewardType {
  FIXED // bonusPerPartner é um valor fixo em R$
  PERCENTAGE // bonusPercentage é aplicado sobre a primeira comissão aprovada do parceiro indicado
  PERCENTAGE_RECURRING // recurringPercentage é aplicado sobre TODA comissão aprovada da rede indicada (não só a 1ª)
}

// Status de ciclo de vida da Empresa — substitui o antigo enum genérico
// `Status` (que ainda serve para User). ACTIVE/INACTIVE preservam o
// significado anterior; OVERDUE/BLOCKED/ARCHIVED são o refinamento de
// inadimplência/arquivamento lógico (ver Company.isArchived e o guard em
// lib/company-access.ts).
enum CompanyStatus {
  ACTIVE
  INACTIVE
  OVERDUE // Inadimplente — ver Company.overdueSince para a janela de carência de 15 dias
  BLOCKED // Bloqueio manual pelo Admin (imediato, sem carência)
  ARCHIVED // "Excluída" logicamente — nunca apagamos os dados
}

enum NotificationType {
  REGISTRATION_PENDING // novo cadastro aguardando aprovação (para Master/Gerente/Admin)
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  BILLING_OVERDUE
  PROGRAM_PAUSED // programa entrou em PAUSED_FOR_NEW_MEMBERS — parceiros vinculados avisados da janela de 30 dias
  PROGRAM_RULES_CHANGED // regras/comissão do programa mudaram — ver ProgramChangeLog
  PROGRAM_MEMBERSHIP_ENDED // saída voluntária, desligamento por inatividade ou encerramento do programa
  PARTNER_PERFORMANCE_MONTHLY // resumo mensal consolidado + alerta de risco de inatividade (ver lib/partner-lifecycle.ts)
  ACCOUNT_DELETION_REQUESTED // usuário pediu exclusão da conta — avisa todos os Admins para análise
  TIMECLOCK_ADJUSTED // Master corrigiu uma batida de ponto — colaborador precisa dar ciência
  PROMOTION_OFFERED // Master aplicou uma promoção de cargo — colaborador precisa aceitar
  COMMISSION_EARNED // parceiro recebeu/teve aprovada uma comissão — dispara efeito sonoro no app (ver components/pwa/earnings-sound.tsx)
  BONUS_AWARDED // colaborador recebeu bônus de meta/premiação — dispara efeito sonoro no app
  INTERNAL_MESSAGE_RECEIVED // nova Comunicação Interna destinada ao usuário/setor
  REFERRAL_VISITED // indicado do parceiro compareceu à unidade (QR escaneado no PDV) — alerta motivacional antes da aprovação da comissão
  TICKET_MESSAGE_RECEIVED // nova mensagem numa conversa de chamado (Suporte Tribuss ou chat com o Estabelecimento)
  GENERIC
}

// Status de ciclo de vida de um Program (Programa de Parceiros) — substitui o
// uso isolado do boolean `active` para representar também a pausa com aviso
// prévio de 30 dias (ver lib/program-lifecycle.ts). `active` é mantido em
// sincronia (true somente quando status = ACTIVE) para não quebrar leituras
// existentes que ainda filtram por ele.
enum ProgramStatus {
  ACTIVE
  PAUSED_FOR_NEW_MEMBERS // fecha para novas adesões; vinculados mantêm acesso total até pauseEffectiveAt (30 dias)
  ARCHIVED // encerrado — nunca apagamos o registro (ver DELETE /api/admin/programs/[id])
}

// Vínculo explícito de um Parceiro a um Program (1 Program por Company, então
// companyId aqui é só uma desnormalização de leitura). Criado automaticamente
// na 1ª Commission do parceiro naquela empresa, ou explicitamente pelo botão
// "Participar" em /partner/explorar. Base da regra de inatividade de 90 dias
// e da confirmação de saída com perda de saldo (ver lib/program-lifecycle.ts).
enum ProgramMembershipStatus {
  ACTIVE
  LEFT_BY_PARTNER // saída voluntária via "Sair do Programa"
  TERMINATED_INACTIVITY // desligamento automático por 90 dias sem atividade
  PROGRAM_ENDED // programa foi arquivado (pausa completou os 30 dias, ou arquivamento direto do Admin)
}

enum AffiliateLinkTarget {
  COMPANY
  PARTNER
}

// Critério de elevação de nível — usado tanto pelo Programa de Parceiros
// (ProgramLevel) quanto, futuramente, por outras réguas de nível.
enum LevelCriteria {
  REFERRAL_COUNT
  REVENUE
  BOTH
}

// Formato do benefício concedido ao subir de nível/cargo.
enum BenefitType {
  PERCENTAGE
  FIXED
  BOTH
}

// Unidade do período de mensuração de um nível/cargo — ALL_TIME = nunca
// rebaixa/reavalia; DAYS/MONTHS combinam com um valor numérico (ver
// measurementValue/periodMonths nos models que usam este enum). A UI (ver
// lib/level-measurement.ts) expõe só um seletor estrito (Vitalício/Mensal/
// Bimestral/Semestral/Anual) que mapeia para (unit, value) — o schema
// continua flexível para não quebrar dados existentes.
enum MeasurementUnit {
  ALL_TIME
  DAYS
  MONTHS
}

// Selo/medalha de um nível — preset do sistema (Ouro/Prata/Bronze/Diamante) ou
// CUSTOM quando o ícone vem de upload (ver ProgramLevel.imageUrl/
// InternalLevelRule.imageUrl). Cor real do selo é sempre badgeColorHex.
enum MedalIcon {
  GOLD
  SILVER
  BRONZE
  DIAMOND
  CUSTOM
}

// Tipo do link publico gerado em /admin/links — decide o formulario e a regra
// de aprovacao em app/join/**.
enum RegistrationLinkType {
  COMPANY_SIGNUP // cria uma nova Empresa (plano/isencao pre-configurados no link)
  EMPLOYEE_SIGNUP // vincula a uma Company especifica (companyId) + setor inicial
  PARTNER_GENERIC // parceiro sem empresa vinculada
  PARTNER_FOR_COMPANY // parceiro pre-vinculado a uma Company especifica (companyId)
}

// Catálogo de planos SaaS — id é fixo (STANDARD/PREMIUM/ENTERPRISE, o mesmo
// valor livre gravado em License.plan), mas limites e preços são editáveis
// pelo Admin em /admin/planos. lib/plans.ts lê esta tabela em runtime.
model Plan {
  id           String   @id // "STANDARD" | "PREMIUM" | "ENTERPRISE"
  label        String
  maxEmployees Int
  maxPartners  Int
  oneTimePrice Decimal  @db.Decimal(10, 2)
  monthlyPrice Decimal  @db.Decimal(10, 2)
  updatedAt    DateTime @updatedAt
}

model Company {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique // "nomads-jeri" | "nomads-lagoa" | "in-on"
  status       CompanyStatus @default(ACTIVE)
  statusReason String? // motivo do bloqueio/inadimplência, exibido no banner/tela de bloqueio
  overdueSince DateTime? // setado quando o Admin marca a empresa como Inadimplente — início da carência de 15 dias (ver lib/company-access.ts)
  isArchived   Boolean       @default(false) // "Excluir" no Admin só arquiva — nunca apaga dados (ver DELETE /api/admin/companies/[id])
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sidebarBg    String?
  sidebarText  String?
  logoUrl      String?
  fontFamily   String?
  fontSize     String?

  // Empresa cadastrada através do link de um Afiliado (/join/company?ref=CODE)
  // — permite ao Afiliado ver "empresas indicadas" e receber comissão
  // fixa/percentual/recorrente sobre a mensalidade (ver lib/affiliate.ts).
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  // Dados cadastrais (pacote completo — CNPJ, endereço, contato, mídia)
  tradeName            String? // Nome Fantasia
  corporateName        String? // Razão Social
  cnpj                 String? @unique
  address              String?
  neighborhood         String? // Bairro — preenchido junto do CEP
  city                 String?
  state                String?
  // Categoria/segmento de negócio (ex: "Pousada", "Restaurante", "Passeio de
  // Buggy") — texto livre preenchido pelo Admin/Master, usado como filtro de
  // busca em /partner/explorar junto com nome e palavra-chave.
  segment              String?
  zipCode              String?
  latitude             Float? // renderização em mapa + centro do geofence do ponto digital
  longitude            Float?
  geofenceRadiusMeters Int     @default(150) // raio (m) a partir de lat/lng aceito na batida de ponto
  shiftClosingDeadline String  @default("22:00") // horário-limite (HH:mm) do fechamento diário da Gerente

  // Horário de funcionamento — até 2 turnos por dia (ex: 11:00-15:00 / 19:00-22:00).
  // Null = turno não configurado/usado por essa empresa.
  operatingShift1Start String?
  operatingShift1End   String?
  operatingShift2Start String?
  operatingShift2End   String?

  phone             String?
  email             String?
  website           String?
  socialLinks       Json? // { instagram, facebook, linkedin, ... }
  shortDescription  String? @db.Text
  profilePictureUrl String?
  coverPictureUrl   String?
  logoWithLabelUrl  String? // logo com rótulo/marca — cabeçalho do colaborador

  // Nota média de 1 a 5 estrelas dada por parceiros com programa ativo na
  // empresa (ver CompanyRating) — denormalizada e recalculada a cada
  // avaliação em lib/company-rating.ts; null = ainda sem nenhuma avaliação.
  avgRating   Decimal? @db.Decimal(3, 2)
  ratingCount Int      @default(0)

  users       User[]
  units       Unit[]
  programs    Program[]
  promotions  Promotion[]
  referrals   Referral[]
  commissions Commission[]
  withdrawals Withdrawal[]
  wallets     WalletTransaction[]
  timeEntries TimeEntry[]
  checklists  Checklist[]

  checklistTemplates      ChecklistTemplate[]
  publicRegistrationLinks PublicRegistrationLink[]
  registrationRequests    PublicRegistrationRequest[]
  tickets                 Ticket[]
  license                 License?

  posts                   Post[]
  occurrences             Occurrence[]
  dailyEvaluations        DailyEvaluation[]
  xpEntries               XpEntry[]
  rewardCatalogItems      RewardCatalogItem[]
  rewardRedemptions       RewardRedemption[]
  timeEntryJustifications TimeEntryJustification[]
  shiftClosings           ShiftClosing[]

  internalProgram InternalProgram?
  sectors         Sector[]
  goals           Goal[]
  ratings         CompanyRating[]

  occurrenceTypeConfigs      OccurrenceTypeConfig[]
  promotionVouchers          PromotionVoucher[]
  monthlyDayOffRecords       MonthlyDayOffRecord[]
  internalMessages           InternalMessage[]
  goalPayouts                GoalPayout[]
  timeclockAdjustmentReviews TimeclockAdjustmentReview[]

  @@index([affiliateId])
  @@index([status])
}

// Licença SaaS da empresa dentro do grupo — hoje uso interno (Nomad's Jeri,
// Nomad's Lagoa, IN-ON), mas o schema já fica pronto para comercialização
// multi-tenant futura. Gerenciada pelo ADMIN em /admin/cadastros.
model License {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  company            Company   @relation(fields: [companyId], references: [id])
  plan               String    @default("ENTERPRISE") // STANDARD, PREMIUM, ENTERPRISE
  status             String    @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED, TRIAL, CANCELED
  maxEmployees       Int       @default(50)
  maxPartners        Int       @default(500)
  billingCycle       String    @default("MONTHLY") // MONTHLY, YEARLY
  isExempt           Boolean   @default(false) // isenta de cobrança (uso interno do grupo)
  exemptionMonths    Int? // duração configurada da isenção — referência para exibição na UI
  exemptionExpiresAt DateTime? // quando passar, um job sob demanda reverte isExempt para false automaticamente
  billingDay         Int? // dia do mês (1-28) em que a cobrança recorrente é gerada
  expiresAt          DateTime?
  canceledAt         DateTime? // preenchido quando status vira CANCELED — base do cálculo de churn
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model User {
  id                         String                @id // == Supabase auth.users.id (uuid), sem @default
  email                      String                @unique
  name                       String
  phone                      String? // WhatsApp/telefone de contato — capturado no cadastro de staff (ex: Master da empresa)
  role                       Role
  status                     Status                @default(ACTIVE)
  accountDeletionStatus      AccountDeletionStatus @default(NONE)
  accountDeletionRequestedAt DateTime?
  accountDeletionReason      String?               @db.Text

  // Preferências de notificação (Header > Avatar > Preferências) — controlam
  // os canais em lib/notifications.ts e o efeito sonoro de ganho financeiro
  // (ver components/pwa/earnings-sound.tsx / NotificationType.COMMISSION_EARNED
  // e BONUS_AWARDED).
  notifyViaPush     Boolean @default(true)
  notifyViaEmail    Boolean @default(true)
  notifyViaWhatsapp Boolean @default(false)
  soundOnEarnings   Boolean @default(true)

  // Até 5 hrefs do menu marcados como favoritos pelo próprio usuário — exibidos
  // em destaque na barra horizontal do mobile (ver components/shared/mobile-nav-bar.tsx).
  // Vazio = usa os 5 primeiros itens visíveis por padrão.
  pinnedMobileNavItems String[] @default([])

  // Conta de Consumo — dívida acumulada de comandas assinadas na casa (ver
  // Occurrence.type = CONSUMO), descontada do salário. Fica no User (não no
  // EmployeeProfile) porque também se aplica à Gerente. Abatida quando uma
  // ocorrência de valor positivo é paga com paymentMethod = CONSUMO.
  consumptionDebt Decimal @default(0) @db.Decimal(10, 2)

  // Autenticação em Duas Etapas (TOTP, RFC 6238 — ver lib/totp.ts). O secret
  // fica gravado já durante o setup (antes de enabled=true) para permitir
  // confirmar o primeiro código sem round-trip extra; só passa a ser exigido
  // no login quando twoFactorEnabled vira true (ver /verificar-2fa).
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  companyId    String? // null quando role = ADMIN ou PARTNER (parceiro não pertence a uma única empresa)
  company      Company?  @relation(fields: [companyId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastActiveAt DateTime?

  partnerProfile  PartnerProfile?
  employeeProfile EmployeeProfile?

  referrals             Referral[]          @relation("PartnerReferrals")
  commissionsAsPartner  Commission[]        @relation("PartnerCommissions")
  commissionsScanned    Commission[]        @relation("ScannedCommissions")
  withdrawals           Withdrawal[]
  walletTransactions    WalletTransaction[] @relation("PartnerWallet")
  walletAdjustmentsMade WalletTransaction[] @relation("WalletAdjustmentBy")
  activityLogs          ActivityLog[]
  auditLogs             AuditLog[]
  accessLogs            AccessLog[]
  timeEntries           TimeEntry[]
  checklistsSubmitted   Checklist[]         @relation("ChecklistEmployee")
  checklistsApproved    Checklist[]         @relation("ChecklistApprover")

  checklistTemplatesCreated    ChecklistTemplate[]         @relation("ChecklistTemplateCreatedBy")
  checklistTemplatesPrimary    ChecklistTemplate[]         @relation("ChecklistTemplatePrimary")
  checklistTemplatesSecondary  ChecklistTemplate[]         @relation("ChecklistTemplateSecondary")
  checklistReassignedFrom      ChecklistReassignment[]     @relation("ChecklistReassignFrom")
  checklistReassignedTo        ChecklistReassignment[]     @relation("ChecklistReassignTo")
  checklistReassignmentsMade   ChecklistReassignment[]     @relation("ChecklistReassignedBy")
  registrationLinksCreated     PublicRegistrationLink[]    @relation("RegistrationLinkCreatedBy")
  registrationRequestsReviewed PublicRegistrationRequest[] @relation("RegistrationRequestReviewedBy")
  ticketsAuthored              Ticket[]                    @relation("TicketAuthor")
  ticketMessagesAuthored       TicketMessage[]             @relation("TicketMessageAuthor")

  postsAuthored                Post[]                      @relation("PostAuthor")
  postsReviewed                Post[]                      @relation("PostReviewedBy")
  postsHidden                  Post[]                      @relation("PostHiddenBy")
  postLikes                    PostLike[]                  @relation("PostLikeUser")
  postComments                 PostComment[]               @relation("PostCommentAuthor")
  postReactions                PostReaction[]              @relation("PostReactionUser")
  occurrencesReceived          Occurrence[]                @relation("OccurrenceEmployee")
  occurrencesCreated           Occurrence[]                @relation("OccurrenceCreatedBy")
  occurrenceTypeConfigsMade    OccurrenceTypeConfig[]      @relation("OccurrenceTypeConfigCreatedBy")
  dailyEvaluationsReceived     DailyEvaluation[]           @relation("DailyEvaluationEmployee")
  dailyEvaluationsGiven        DailyEvaluation[]           @relation("DailyEvaluationEvaluator")
  xpEntries                    XpEntry[]                   @relation("XpEntryEmployee")
  rewardRedemptions            RewardRedemption[]          @relation("RewardRedemptionEmployee")
  rewardRedemptionsReviewed    RewardRedemption[]          @relation("RewardRedemptionReviewedBy")
  timeJustifications           TimeEntryJustification[]    @relation("TimeJustificationEmployee")
  timeJustificationsReviewed   TimeEntryJustification[]    @relation("TimeJustificationReviewedBy")
  shiftClosingsClosed          ShiftClosing[]              @relation("ShiftClosingClosedBy")
  timeEntriesAdjusted          TimeEntry[]                 @relation("TimeEntryAdjustedBy")
  timeclockAdjustmentsReceived TimeclockAdjustmentReview[] @relation("TimeclockAdjustmentEmployee")
  timeclockAdjustmentsReviewed TimeclockAdjustmentReview[] @relation("TimeclockAdjustmentReviewedBy")
  promotionVouchersIssued      PromotionVoucher[]          @relation("PromotionVoucherIssuedBy")
  promotionVouchersRedeemed    PromotionVoucher[]          @relation("PromotionVoucherRedeemedBy")

  employeeTermAcceptances EmployeeTermAcceptance[] @relation("EmployeeTermAcceptanceUser")
  partnerTermAcceptances  PartnerTermAcceptance[]  @relation("PartnerTermAcceptanceUser")
  goalsAsIndividual       Goal[]                   @relation("GoalEmployee")
  goalsCreated            Goal[]                   @relation("GoalCreatedBy")
  goalRecordsReported     GoalRecord[]             @relation("GoalRecordReportedBy")
  goalPayoutsReceived     GoalPayout[]             @relation("GoalPayoutEmployee")
  goalPayoutsRegistered   GoalPayout[]             @relation("GoalPayoutPaidBy")

  internalMessagesSent   InternalMessage[]      @relation("InternalMessageSender")
  internalMessagesToMe   InternalMessage[]      @relation("InternalMessageRecipientEmployee")
  internalMessageReplies InternalMessageReply[] @relation("InternalMessageReplyAuthor")

  notifications Notification[]

  programMemberships     ProgramMembership[] @relation("ProgramMembershipPartner")
  programChangesAuthored ProgramChangeLog[]  @relation("ProgramChangeAuthor")
  companyRatingsGiven    CompanyRating[]     @relation("CompanyRatingPartner")

  @@index([companyId])
  @@index([role])
}

model PartnerProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerType    PartnerType @default(INDIVIDUAL)
  document       String? // CPF (INDIVIDUAL) ou CNPJ (AGENCY) — mantido por compat; ver `cpf` abaixo
  companyName    String? // Razão social — só para AGENCY
  phone          String?
  photoUrl       String?
  pixKey         String?
  bankName       String? // Dados bancários — junto com pixKey, exigidos antes da 1ª Solicitação de Saque (ver app/api/partner/withdrawals)
  accountType    String?
  agency         String?
  accountNumber  String?
  walletBalance  Decimal     @default(0) @db.Decimal(12, 2)
  currentLevelId String?

  // Pacote completo de cadastro do parceiro
  fullName          String?
  nickname          String?       @unique // login por apelido
  whatsapp          String? // pode ser usado como login
  email             String? // contato opcional — distinto do User.email (credencial de login)
  cpf               String?       @unique // exigido ao solicitar saque
  bio               String?       @db.Text // pesquisável pela plataforma
  currentLevel      ProgramLevel? @relation(fields: [currentLevelId], references: [id])
  currentLevelSince DateTime? // desde quando está no nível atual — base do rebaixamento automático por período (ver lib/partner-levels.ts)
  registeredAt      DateTime      @default(now())

  // Hierarquia Agência (pai) -> Colaboradores/guias (filhos).
  // Comissões geradas pelos filhos são consolidadas no saldo do pai (regra aplicada em código).
  parentId      String?
  parent        PartnerProfile?  @relation("AgencyCollaborators", fields: [parentId], references: [id])
  collaborators PartnerProfile[] @relation("AgencyCollaborators")

  // Indicado por um Afiliado/Influencer via /join/partner?ref=CODIGO
  affiliateId          String?
  affiliate            Affiliate?        @relation(fields: [affiliateId], references: [id])
  affiliateMilestoneAt DateTime? // preenchido quando o bônus de milestone (10 clientes) já foi pago — evita pagar 2x
  affiliatePayouts     AffiliatePayout[]
  affiliateSelf        Affiliate?        @relation("AffiliateSelf")

  @@index([parentId])
  @@index([affiliateId])
}

model EmployeeProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isScannerOnly Boolean   @default(false)
  primaryUnitId String? // extensão para geofencing do ponto digital (fase futura)
  primaryUnit   Unit?     @relation(fields: [primaryUnitId], references: [id])
  xpPoints      Int       @default(0) // pontos acumulados NO NÍVEL ATUAL — zera a cada promoção (ver currentInternalLevelId)
  lastXpSeenAt  DateTime? // último acesso em que o colaborador viu o extrato — base do pop-up +XX/-XX

  // Nível atual no Programa Interno da empresa — ponteiro explícito, não mais
  // derivado só por comparação de XP: uma promoção move este ponteiro E zera
  // xpPoints, iniciando um novo ciclo de pontuação (ver lib/gamification.ts).
  currentInternalLevelId    String?
  currentInternalLevel      InternalLevelRule? @relation(fields: [currentInternalLevelId], references: [id])
  currentInternalLevelSince DateTime? // desde quando está no cargo atual — base do período de mensuração/rebaixamento E do tempo mínimo de permanência (InternalLevelRule.minTenureMonths)

  // Promoção aplicada pelo Master (botão "Aplicar Promoção") mas ainda não
  // confirmada pelo Colaborador (botão "Aceitar Promoção") — ver
  // app/api/company/employees/[id]/promote e .../promotion/accept.
  pendingPromotionLevelId   String?
  pendingPromotionLevel     InternalLevelRule? @relation("PendingPromotion", fields: [pendingPromotionLevelId], references: [id])
  pendingPromotionOfferedAt DateTime?

  // Permite que este colaborador registre Ocorrências em modo CREATE_ONLY
  // (sem ver histórico, editar ou excluir) — concedido pelo Master/Gerente.
  canRegisterOccurrences Boolean  @default(false)
  monthlySalary          Decimal? @db.Decimal(10, 2) // usado para calcular o abate de 1 dia em FALTA sem ATESTADO

  // Setor, turno e janela de trabalho — usados para calcular o Banco de Horas
  // a cada batida de ponto fora do horário previsto (ver app/api/company/timeclock).
  sectorId                   String?
  sector                     Sector?    @relation(fields: [sectorId], references: [id])
  shiftType                  ShiftType?
  workStartTime              String? // "HH:mm"
  workEndTime                String?
  breakStartTime             String?
  breakEndTime               String?
  bankOfHoursMinutes         Int        @default(0) // positivo = hora extra acumulada; negativo = déficit
  dailyBreakAllowanceMinutes Int        @default(60) // Tempo Total de Pausa Diária Permitida — pode ser usado picado ou de uma vez (ver TimeEntry BREAK_START/BREAK_END)

  // Horário por dia da semana — sobrepõe workStartTime/workEndTime/
  // breakStartTime/breakEndTime quando presente. Formato:
  // { "MON": {"start":"08:00","end":"18:00","breakStart":"12:00","breakEnd":"13:00"}, ... }
  // chaves MON..SUN; dia ausente = usa os campos únicos acima como fallback.
  weeklySchedule Json?

  // Dia de folga semanal fixo (0=domingo..6=sábado) — informativo, usado no
  // Mapa/Colaboradores e para não cobrar ponto nesse dia.
  weeklyDayOff Int?

  // Direito a 1 folga adicional por mês (ver model MonthlyDayOffRecord) — se
  // não for gozada até o fim do mês, o sistema sinaliza o pagamento
  // equivalente a 1 diária junto ao salário na folha (ver app/company/colaboradores).
  hasExtraMonthlyDayOff Boolean @default(false)

  // Responsável pelo Módulo Financeiro da empresa (além do Master) — ver
  // lib/permissions.ts#canAccessFinanceModule.
  isFinanceResponsible Boolean @default(false)

  // Responsável por receber Comunicações Internas destinadas ao seu Setor
  // (ver InternalMessage, recipientType = SECTOR).
  isSectorCommunicationResponsible Boolean @default(false)

  monthlyDayOffRecords MonthlyDayOffRecord[]

  // Registro completo de RH — preenchimento opcional, feito por etapas.
  isProfileComplete Boolean @default(false)

  // Dados pessoais & documentos
  fullName            String?
  nickname            String?
  cpf                 String?   @unique
  rg                  String?
  rgIssuer            String?
  birthDate           DateTime?
  gender              String?
  maritalStatus       String?
  voterCard           String?
  militaryCertificate String?
  cnh                 String?
  cnhCategory         String?

  // Endereço & contato
  street                String?
  number                String?
  neighborhood          String?
  city                  String?
  state                 String?
  zipCode               String?
  personalPhone         String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Dados bancários
  bankName      String?
  accountType   String?
  agency        String?
  accountNumber String?
  pixKey        String?

  // Documentação (URLs de Storage)
  cpfDocUrl           String?
  rgDocUrl            String?
  proofOfResidenceUrl String?
  photoUrl            String?
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Unit {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  address     String
  phone       String
  email       String
  description String   @db.Text
  photos      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promotions         PromotionUnit[]
  commissions        Commission[]
  employeesAssigned  EmployeeProfile[]
  timeEntries        TimeEntry[]
  checklists         Checklist[]
  checklistTemplates ChecklistTemplate[]

  @@index([companyId])
}

// Programa de Parceiros — no MÁXIMO 1 por empresa (@@unique companyId).
// Promoções ("1 Caipirinha grátis" etc, ver model Promotion) são ilimitadas e
// táticas; este model é o programa de comissão/níveis/termos em si.
model Program {
  id               String           @id @default(cuid())
  companyId        String           @unique
  company          Company          @relation(fields: [companyId], references: [id])
  name             String
  description      String           @db.Text
  commissionType   CommissionType
  commissionValue  Decimal          @db.Decimal(10, 2)
  commissionFormat CommissionFormat @default(PERCENTAGE)
  fixedValue       Decimal?         @db.Decimal(10, 2) // parte fixa em R$ quando commissionType = BOTH (commissionValue guarda a % nesse caso)
  productUnitLabel String? // rótulo da unidade quando commissionFormat = PRODUCT_UNIT (ex: "diária grátis")
  hasLevels        Boolean          @default(false)
  autoUpgrade      Boolean          @default(false)
  autoDowngrade    Boolean          @default(false) // rebaixa automaticamente o parceiro que não sustentar o desempenho no período de mensuração do nível (ver lib/partner-levels.ts)
  active           Boolean          @default(true) // mantido em sincronia com `status` (true somente quando status = ACTIVE) — ver lib/program-lifecycle.ts
  status           ProgramStatus    @default(ACTIVE)
  pausedAt         DateTime? // quando entrou em PAUSED_FOR_NEW_MEMBERS
  pauseEffectiveAt DateTime? // pausedAt + 30 dias — quando a pausa vira ARCHIVED de fato (varredura preguiçosa, ver lib/program-lifecycle.ts)
  archivedAt       DateTime?
  contractUrl      String?
  imageUrl         String? // imagem/foto de capa representativa do programa
  pdfUrl           String? // anexo PDF com regras completas
  videoUrl         String? // vídeo institucional (URL externa — YouTube/Vimeo)
  termsContent     String?          @db.Text // regulamento/termo de aceite (HTML do editor rico)
  validFrom        DateTime? // null junto com validUntil = prazo indeterminado
  validUntil       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  levels          ProgramLevel[]
  materials       ProgramMaterial[]
  referrals       Referral[]
  termAcceptances PartnerTermAcceptance[]
  changeLog       ProgramChangeLog[]
  memberships     ProgramMembership[]
  commissions     Commission[]
}

model ProgramLevel {
  id                   String  @id @default(cuid())
  programId            String
  program              Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  name                 String // Prata / Ouro / Diamante
  order                Int     @default(0)
  commissionPercentage Decimal @db.Decimal(5, 2)
  bonusDescription     String?
  badgeColorHex        String  @default("#C0C0C0")

  // Critério de elevação — REFERRAL_COUNT usa requiredReferralCount, REVENUE
  // usa requiredRevenueAmount, BOTH exige os dois simultaneamente.
  criteria              LevelCriteria @default(REFERRAL_COUNT)
  requiredReferralCount Int
  requiredRevenueAmount Decimal?      @db.Decimal(10, 2)

  // Período de mensuração para MANTER o nível — ALL_TIME nunca rebaixa;
  // MONTHS usa periodMonths como janela rolante (ver lib/partner-levels.ts).
  measurementUnit MeasurementUnit @default(ALL_TIME)
  periodMonths    Int             @default(0)

  // Benefício concedido ao atingir o nível, além da comissão base do Program.
  benefitType      BenefitType @default(PERCENTAGE)
  bonusFixedAmount Decimal?    @db.Decimal(10, 2)

  // Personalização visual — badgeColorHex já existia (tema/paleta do nível);
  // medalIcon escolhe entre as 4 medalhas do sistema ou CUSTOM (ver imageUrl).
  medalIcon MedalIcon @default(GOLD)
  imageUrl  String? // ícone customizado (upload) — sobrepõe medalIcon quando presente

  partners PartnerProfile[]

  @@index([programId])
}

model ProgramMaterial {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String
  createdAt DateTime @default(now())
}

// Histórico de alterações de regras/comissão de um Program — alimenta o link
// "Ver Histórico" enviado na notificação PROGRAM_RULES_CHANGED (ver
// lib/program-lifecycle.ts#recordProgramChange, chamado de PUT/PATCH
// /api/company/program e /api/admin/programs/[id] quando campos sensíveis mudam).
model ProgramChangeLog {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User     @relation("ProgramChangeAuthor", fields: [changedById], references: [id])
  summary     String   @db.Text // resumo humano pronto para exibir ("Comissão alterada de 10% para 15%")
  changes     Json // { campo: { before, after } }
  createdAt   DateTime @default(now())

  @@index([programId])
  @@index([createdAt])
}

// Vínculo do Parceiro a um Program — ver ProgramMembershipStatus. companyId é
// uma desnormalização de leitura (1 Program por Company). Criado no 1º
// Commission do parceiro naquela empresa (auto-enroll) ou explicitamente pelo
// botão "Participar" em /partner/explorar.
model ProgramMembership {
  id                String                  @id @default(cuid())
  programId         String
  program           Program                 @relation(fields: [programId], references: [id], onDelete: Cascade)
  companyId         String
  partnerId         String
  partner           User                    @relation("ProgramMembershipPartner", fields: [partnerId], references: [id])
  status            ProgramMembershipStatus @default(ACTIVE)
  joinedAt          DateTime                @default(now())
  // Última Commission/atividade do parceiro nesta empresa — base da regra de
  // desligamento automático por 90 dias (ver lib/program-lifecycle.ts).
  lastActivityAt    DateTime                @default(now())
  // Último ProgramChangeLog que o parceiro já confirmou aceite ou dispensou —
  // controla o CTA "Confirmar Aceite"/"Solicitar Saída" na notificação de mudança de regras.
  lastChangeAckAt   DateTime?
  terminatedAt      DateTime?
  terminationReason String? // "LEFT_BY_PARTNER" | "INACTIVITY_90_DAYS" | "PROGRAM_ENDED"
  // Saldo pendente (comissões aprovadas ainda não sacadas) perdido no momento
  // da saída/desligamento — preenchido só quando > 0 (ver lib/program-lifecycle.ts#leaveProgramMembership).
  forfeitedBalance  Decimal?                @db.Decimal(12, 2)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([programId, partnerId])
  @@index([partnerId])
  @@index([companyId])
  @@index([status])
}

// Avaliação de 1 a 5 estrelas de uma Empresa por um Parceiro com programa
// ativo nela — 1 por par (companyId, partnerId), atualizável. Alimenta
// Company.avgRating/ratingCount (ver lib/company-rating.ts) e o filtro de
// nota mínima em /partner/explorar.
model CompanyRating {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partnerId String
  partner   User     @relation("CompanyRatingPartner", fields: [partnerId], references: [id])
  stars     Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, partnerId])
  @@index([companyId])
}

model Promotion {
  id                    String             @id @default(cuid())
  companyId             String
  company               Company            @relation(fields: [companyId], references: [id])
  title                 String
  description           String             @db.Text
  bannerUrl             String?
  offerType             PromotionOfferType @default(DISCOUNT)
  audience              PromotionAudience  @default(EXTERNAL) // EXTERNAL = parceiros da plataforma; INTERNAL = só o Colaborador oferece no balcão (ex: Vale Retorno)
  originalPrice         Decimal?           @db.Decimal(10, 2) // "Valor Real" (de-para do desconto)
  discountedPrice       Decimal?           @db.Decimal(10, 2) // "Valor Promocional" — alternativa a discountPercentage
  discountPercentage    Decimal?           @db.Decimal(5, 2) // "% de Desconto" — alternativa a discountedPrice
  creditAmount          Decimal?           @db.Decimal(10, 2) // valor do crédito em dinheiro na comanda (offerType = CASH_CREDIT)
  validFrom             DateTime
  validUntil            DateTime
  qrCodeValidityMinutes Int                @default(15)
  stock                 Int? // null = ilimitado
  cost                  Decimal            @db.Decimal(10, 2)
  usedCount             Int                @default(0)
  active                Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  units       PromotionUnit[] // sem linhas = todas as unidades
  commissions Commission[]
  vouchers    PromotionVoucher[]

  @@index([companyId])
}

model PromotionUnit {
  promotionId String
  unitId      String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([promotionId, unitId])
}

// "Vale Retorno" — Colaborador emite um QR Code de uma Promotion (normalmente
// audience=INTERNAL) para um cliente que já esteve na unidade voltar em outra
// data, enviado via WhatsApp/E-mail (ver lib/promotion-share.ts). O `code` vai
// dentro do QR e é o que o Scanner PDV lê para dar baixa (ver
// app/api/company/scanner/redeem) — status muda para REDEEMED e fica ligado à
// Commission gerada no resgate.
model PromotionVoucher {
  id          String                 @id @default(cuid())
  companyId   String
  company     Company                @relation(fields: [companyId], references: [id])
  promotionId String
  promotion   Promotion              @relation(fields: [promotionId], references: [id])
  code        String                 @unique @default(cuid())
  issuedById  String
  issuedBy    User                   @relation("PromotionVoucherIssuedBy", fields: [issuedById], references: [id])
  clientName  String?
  clientPhone String?
  clientEmail String?
  channel     String? // "whatsapp" | "email" | "manual"
  status      PromotionVoucherStatus @default(PENDING)
  expiresAt   DateTime?

  // Baixa do voucher — não gera Commission (não é indicação de Parceiro; o
  // próprio Colaborador ofertou direto ao cliente), só registra o resgate.
  redeemedById              String?
  redeemedBy                User?     @relation("PromotionVoucherRedeemedBy", fields: [redeemedById], references: [id])
  redeemedAmount            Decimal?  @db.Decimal(10, 2)
  redeemedBillJustification String?
  redeemedAttachmentUrl     String?
  redeemedAt                DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([promotionId])
  @@index([status])
}

model Referral {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  partnerId        String
  partner          User           @relation("PartnerReferrals", fields: [partnerId], references: [id])
  programId        String?
  program          Program?       @relation(fields: [programId], references: [id])
  clientName       String
  clientEmail      String
  clientPhone      String
  indicatedAt      DateTime       @default(now())
  visited          Boolean        @default(false)
  visitDate        DateTime?
  billAmount       Decimal?       @db.Decimal(10, 2)
  commissionAmount Decimal?       @db.Decimal(10, 2)
  status           ReferralStatus @default(PENDING)

  commission Commission?

  @@index([companyId])
  @@index([partnerId])
}

model Commission {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  partnerId         String
  partner           User             @relation("PartnerCommissions", fields: [partnerId], references: [id])
  unitId            String?
  unit              Unit?            @relation(fields: [unitId], references: [id])
  promotionId       String?
  promotion         Promotion?       @relation(fields: [promotionId], references: [id])
  // Preenchido só na indicação "pura" ao Programa de Parceria (sem Promotion
  // específica) registrada no Scanner PDV — guarda qual Program/regra de
  // comissão foi aplicado no cálculo automático (ver lib/referral-commission.ts).
  programId         String?
  program           Program?         @relation(fields: [programId], references: [id])
  referralId        String?          @unique
  referral          Referral?        @relation(fields: [referralId], references: [id])
  scannedById       String?
  scannedBy         User?            @relation("ScannedCommissions", fields: [scannedById], references: [id])
  clientName        String
  customerPhone     String?
  qrCodeId          String?          @unique
  // Valor total da conta do cliente indicado — obrigatório no registro do PDV
  // (mesmo comissão fixa, para fins de faturamento gerado). Pode ser 0,00
  // quando acompanhado de billJustification.
  amount            Decimal?         @db.Decimal(10, 2)
  billJustification String? // obrigatória quando amount = 0 (ex: "cliente desistiu antes de consumir")
  commissionValue   Decimal?         @db.Decimal(10, 2)
  status            CommissionStatus @default(PENDING)
  acceptedAt        DateTime?
  deadline          DateTime?
  billAttachmentUrl String?
  date              DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([companyId])
  @@index([partnerId])
  @@index([status])
}

model Withdrawal {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  partnerId         String
  partner           User             @relation(fields: [partnerId], references: [id])
  amount            Decimal          @db.Decimal(10, 2)
  requestDate       DateTime         @default(now())
  status            WithdrawalStatus @default(PENDING)
  pixKey            String?
  bankAccount       String?
  rejectionReason   String?
  proofOfPaymentUrl String? // comprovante de transferência PIX anexado pelo Financeiro
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([companyId])
  @@index([partnerId])
}

model WalletTransaction {
  id          String                  @id @default(cuid())
  companyId   String
  company     Company                 @relation(fields: [companyId], references: [id])
  partnerId   String
  partner     User                    @relation("PartnerWallet", fields: [partnerId], references: [id])
  type        WalletTransactionType
  amount      Decimal                 @db.Decimal(10, 2)
  description String
  status      WalletTransactionStatus @default(COMPLETED)
  createdById String?
  createdBy   User?                   @relation("WalletAdjustmentBy", fields: [createdById], references: [id])
  createdAt   DateTime                @default(now())

  @@index([companyId])
  @@index([partnerId])
}

// Trilha de auditoria — acesso exclusivo do ADMIN.
// Preenchido automaticamente pelo client extension em lib/audit.ts para
// ações críticas de ADMIN e usuários de empresa (Master, Gerente, Financeiro).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String?
  action    String // CREATE, UPDATE, DELETE, PIX_APPROVAL, CHECKIN_OVERRIDE, etc.
  entity    String // User, Company, Checklist, Referral, Withdrawal, ...
  entityId  String?
  details   Json? // dados alterados (antes e depois)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// Um evento de acesso (login por senha ou OAuth) — distinto de User.lastActiveAt
// (que só guarda o último timestamp). Usado para calcular "número de acessos"
// separado de "usuários únicos" no Dashboard do Admin (DAU/MAU/engajamento).
model AccessLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}

// Ponto digital do colaborador — check-in/check-out com geolocalização.
model TimeEntry {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  unitId    String?
  unit      Unit?         @relation(fields: [unitId], references: [id])
  type      TimeEntryType
  latitude  Decimal       @db.Decimal(9, 6)
  longitude Decimal       @db.Decimal(9, 6)
  createdAt DateTime      @default(now())

  // Correção manual pelo Master (horário lançado errado) — o colaborador é
  // notificado (NotificationType.TIMECLOCK_ADJUSTED) e precisa dar ciência
  // clicando "Ciente" (ver Notification.readAt, reaproveitado como ciência).
  isManagerAdjusted Boolean   @default(false)
  adjustedById      String?
  adjustedBy        User?     @relation("TimeEntryAdjustedBy", fields: [adjustedById], references: [id])
  adjustmentNote    String?
  adjustedAt        DateTime?

  @@index([userId])
  @@index([companyId])
}

// Modelo/definição de uma tarefa recorrente de checklist, criada pelo Admin
// ou pelo Gerente da empresa. Cada execução do colaborador vira um Checklist
// (instância) vinculado a este template.
model ChecklistTemplate {
  id                    String              @id @default(cuid())
  companyId             String
  company               Company             @relation(fields: [companyId], references: [id])
  unitId                String?
  unit                  Unit?               @relation(fields: [unitId], references: [id])
  title                 String
  description           String?             @db.Text
  recurrence            ChecklistRecurrence
  // Só usados conforme a recorrência: WEEKLY usa recurrenceDayOfWeek (0=domingo..6=sábado);
  // MONTHLY/BIMONTHLY/TRIMONTHLY/SEMIANNUAL/ANNUAL usam recurrenceDayOfMonth (1-31, ou -1 = último dia do mês).
  recurrenceDayOfWeek   Int?
  recurrenceDayOfMonth  Int?
  // Mês de início/âncora (0=janeiro..11=dezembro) a partir do qual se conta o
  // ciclo de BIMONTHLY/TRIMONTHLY/SEMIANNUAL/ANNUAL — null equivale a 0 (janeiro),
  // preservando o comportamento anterior (ex: trimestral = jan/abr/jul/out).
  recurrenceAnchorMonth Int?
  priority              ChecklistPriority   @default(MEDIUM)
  dueTime               String // horário limite diário de conclusão, formato "HH:mm"
  requiresPhoto         Boolean             @default(true)
  active                Boolean             @default(true)
  createdById           String
  createdBy             User                @relation("ChecklistTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Responsável principal e secundário — se nenhum for definido, a tarefa fica
  // aberta para qualquer colaborador (comportamento antigo). Se o principal
  // faltar (sem check-in no dia) ou estiver inativo, a instância do dia é
  // automaticamente transferida para o secundário; se ambos faltarem, cai no
  // Checklist Master da Gerente/Master (ver lib/checklist-engine.ts).
  primaryEmployeeId   String?
  primaryEmployee     User?   @relation("ChecklistTemplatePrimary", fields: [primaryEmployeeId], references: [id])
  secondaryEmployeeId String?
  secondaryEmployee   User?   @relation("ChecklistTemplateSecondary", fields: [secondaryEmployeeId], references: [id])

  instances Checklist[]

  @@index([companyId])
}

// Instância diária de um ChecklistTemplate (ou tarefa avulsa quando templateId
// é null) — criada preventivamente por ensureTodayChecklistInstances() para o
// dia corrente (forDate), e só recebe foto/observação quando o colaborador
// efetivamente entrega (submittedAt). Aprovada/devolvida/reprovada pela Gerente.
model Checklist {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id])
  unitId           String?
  unit             Unit?              @relation(fields: [unitId], references: [id])
  templateId       String? // null = tarefa avulsa, não vinculada a uma recorrência
  template         ChecklistTemplate? @relation(fields: [templateId], references: [id])
  employeeId       String
  employee         User               @relation("ChecklistEmployee", fields: [employeeId], references: [id])
  forDate          DateTime // dia (00:00) a que esta instância pertence — chave de deduplicação com templateId
  title            String
  notes            String?
  photoUrl         String?
  priority         ChecklistPriority  @default(MEDIUM)
  dueAt            DateTime?
  status           ChecklistStatus    @default(PENDING)
  submittedAt      DateTime? // quando o colaborador entregou (distinto de createdAt = quando a instância foi gerada)
  isAutoReassigned Boolean            @default(false) // true = caiu aqui por ausência do responsável original (alerta visual)
  // true = instância voluntária do responsável SECUNDÁRIO ajudando com o
  // principal presente (não é reatribuição por ausência) — linha extra e
  // independente da instância do principal, aprovada com bônus de XP
  // (ver lib/gamification.ts InternalProgram.pointsChecklistExtraTask).
  isExtraTask      Boolean            @default(false)
  rejectionReason  String? // motivo de "Devolver" ou "Não Entregue"
  approvedById     String?
  approvedBy       User?              @relation("ChecklistApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime           @default(now())

  reassignments ChecklistReassignment[]

  // Sem constraint única de (templateId, forDate) no banco — dados históricos de
  // antes desta feature já têm múltiplas execuções no mesmo dia/template.
  // ensureTodayChecklistInstances() deduplica em código (findFirst + create).
  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([templateId])
  @@index([forDate])
}

// Histórico de transferência de atribuição de um checklist entre colaboradores
// — a tarefa (Checklist.employeeId) é atualizada para o novo responsável, mas
// cada transferência fica preservada aqui.
model ChecklistReassignment {
  id             String    @id @default(cuid())
  checklistId    String
  checklist      Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  fromUserId     String
  fromUser       User      @relation("ChecklistReassignFrom", fields: [fromUserId], references: [id])
  toUserId       String
  toUser         User      @relation("ChecklistReassignTo", fields: [toUserId], references: [id])
  reassignedById String
  reassignedBy   User      @relation("ChecklistReassignedBy", fields: [reassignedById], references: [id])
  reason         String?
  createdAt      DateTime  @default(now())

  @@index([checklistId])
}

// Link público de auto-cadastro de colaboradores, gerado por empresa.
// Cada pessoa que se cadastra através do link gera um PublicRegistrationRequest
// separado, com status próprio — o link em si permanece ativo/reutilizável.
model PublicRegistrationLink {
  id     String               @id @default(cuid())
  type   RegistrationLinkType @default(EMPLOYEE_SIGNUP)
  token  String               @unique @default(cuid())
  active Boolean              @default(true)

  // EMPLOYEE_SIGNUP e PARTNER_FOR_COMPANY apontam para uma empresa; COMPANY_SIGNUP
  // e PARTNER_GENERIC deixam null.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  role      Role     @default(EMPLOYEE) // papel concedido — só relevante para EMPLOYEE_SIGNUP
  sectorId  String? // setor/cargo inicial — só relevante para EMPLOYEE_SIGNUP
  sector    Sector?  @relation(fields: [sectorId], references: [id])

  // Configuração pré-definida para links do tipo COMPANY_SIGNUP.
  plan            String?
  isExempt        Boolean @default(false)
  exemptionMonths Int?

  // Rastreio de origem/campanha (ex: "utm_source=instagram_influencer1").
  origin String?

  createdById String
  createdBy   User      @relation("RegistrationLinkCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  requests PublicRegistrationRequest[]

  @@index([companyId])
  @@index([type])
}

// Cadastro submetido por alguém de fora da plataforma, pendente de aprovação
// do Admin/Master antes de virar um User real. Dois canais de entrada:
//   1) Link tokenizado gerado no admin (PublicRegistrationLink) — linkId setado,
//      role vem de link.role.
//   2) Página pública direta (/join/company/[slug] ou /join/partner) — sem
//      link/token pré-gerado, então linkId e companyId ficam null e `role`
//      (default EMPLOYEE, ou PARTNER quando vindo de /join/partner) é usado direto.
model PublicRegistrationRequest {
  id                 String                  @id @default(cuid())
  linkId             String?
  link               PublicRegistrationLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  companyId          String?
  company            Company?                @relation(fields: [companyId], references: [id])
  role               Role                    @default(EMPLOYEE)
  sectorId           String? // setor inicial escolhido (herdado do link ou selecionado no formulário público)
  sector             Sector?                 @relation(fields: [sectorId], references: [id])
  name               String // COMPANY_SIGNUP: nome da empresa. Demais tipos: nome da pessoa.
  desiredCompanySlug String? // só para links do tipo COMPANY_SIGNUP — slug pretendido da nova empresa
  masterName         String? // só para links do tipo COMPANY_SIGNUP — nome do responsável/Master
  email              String
  phone              String
  document           String?
  affiliateId        String?
  affiliate          Affiliate?              @relation(fields: [affiliateId], references: [id])
  status             RegistrationStatus      @default(PENDING_APPROVAL)
  reviewedById       String?
  reviewedBy         User?                   @relation("RegistrationRequestReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  rejectionReason    String?
  createdUserId      String? // preenchido quando aprovado e o User real é provisionado
  createdAt          DateTime                @default(now())

  @@index([companyId])
  @@index([status])
  @@index([affiliateId])
}

// Afiliado/Influencer com link de indicação exclusivo (/join/partner?ref=CODE).
// Recebe bônus quando um parceiro que ele indicou é aprovado, e um bônus extra
// de milestone quando esse parceiro atinge seus primeiros N clientes convertidos.
model Affiliate {
  id                   String              @id @default(cuid())
  name                 String
  email                String?             @unique
  phone                String?
  code                 String              @unique @default(cuid()) // usado em /join/partner?ref=CODE ou /join/partner/[affiliateCode]
  active               Boolean             @default(true)
  rewardType           AffiliateRewardType @default(FIXED)
  bonusPerPartner      Decimal             @default(0) @db.Decimal(10, 2) // valor fixo pago quando o parceiro indicado é aprovado (rewardType = FIXED)
  bonusPercentage      Decimal?            @db.Decimal(5, 2) // % sobre a 1ª comissão aprovada do parceiro indicado (rewardType = PERCENTAGE)
  recurringPercentage  Decimal?            @db.Decimal(5, 2) // % sobre TODA comissão da rede indicada e mensalidade das empresas indicadas (rewardType = PERCENTAGE_RECURRING)
  milestoneClientCount Int                 @default(10) // "10 primeiros clientes convertidos" — mantido por compat; novos milestones usam AffiliateMilestone
  milestoneBonus       Decimal             @default(0) @db.Decimal(10, 2) // pago ao atingir o milestone acima
  pixKey               String?
  walletBalance        Decimal             @default(0) @db.Decimal(12, 2)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Quando o Afiliado é um Parceiro real da plataforma (promovido pelo Admin) —
  // a desativação do User correspondente desativa este Affiliate automaticamente
  // (ver lib/affiliate.ts). Fica null para afiliados externos (influencers sem
  // conta de parceiro).
  partnerProfileId String?         @unique
  partnerProfile   PartnerProfile? @relation("AffiliateSelf", fields: [partnerProfileId], references: [id])

  partners          PartnerProfile[]
  referredCompanies Company[]
  joinRequests      PublicRegistrationRequest[]
  payouts           AffiliatePayout[]
  milestones        AffiliateMilestone[]
  linkVisits        AffiliateLinkVisit[]

  @@index([active])
}

model AffiliatePayout {
  id          String                @id @default(cuid())
  affiliateId String
  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  partnerId   String?
  partner     PartnerProfile?       @relation(fields: [partnerId], references: [id])
  companyId   String? // preenchido quando o payout vem de uma empresa indicada (mensalidade), não de um parceiro
  type        AffiliatePayoutType
  amount      Decimal               @db.Decimal(10, 2)
  status      AffiliatePayoutStatus @default(PENDING)
  periodKey   String? // "AAAA-MM" — chave de idempotência dos payouts recorrentes (1 por afiliado/origem/mês)
  paidAt      DateTime?
  createdAt   DateTime              @default(now())

  @@index([affiliateId])
  @@index([partnerId])
  @@index([companyId])
}

// Marco de bonificação fixa multi-nível, configurado pelo Admin no painel do
// Afiliado (botão "+"). Pago uma única vez, quando `achievedAt` é preenchido
// (ver lib/affiliate.ts#checkAffiliateMilestones).
model AffiliateMilestone {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order       Int       @default(0)
  targetCount Int // nº de parceiros/empresas convertidos para atingir este marco
  bonusAmount Decimal   @db.Decimal(10, 2)
  achievedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([affiliateId, order])
  @@index([affiliateId])
}

// 1 registro por acesso ao link de indicação (/join/partner?ref=CODE ou
// /join/company?ref=CODE) — métrica de topo de funil, distinta de conversão
// (ver PublicRegistrationRequest/PartnerProfile/Company.affiliateId).
model AffiliateLinkVisit {
  id          String              @id @default(cuid())
  affiliateId String
  affiliate   Affiliate           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  target      AffiliateLinkTarget
  createdAt   DateTime            @default(now())

  @@index([affiliateId])
}

// Chamado aberto por Colaborador, Gerente ou Parceiro na Central de Comunicação.
model Ticket {
  id        String       @id @default(cuid())
  companyId String?
  company   Company?     @relation(fields: [companyId], references: [id])
  authorId  String
  author    User         @relation("TicketAuthor", fields: [authorId], references: [id])
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages TicketMessage[]

  @@index([companyId])
  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TicketMessageAuthor", fields: [authorId], references: [id])
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Área da Empresa (/company) — mural, RH operacional e gamificação.
// Todo o app/api/company/** deriva companyId da sessão (nunca de input do
// cliente), então estes modelos não precisam de dono de tenant além do já
// existente `companyId` — ver lib/api-auth.ts#requireCompanyStaff.
// ---------------------------------------------------------------------------

// Mural de novidades. Post de Gerente/Master é publicado direto; post de
// Colaborador nasce PENDING_APPROVAL e precisa de revisão da gerência.
model Post {
  id              String     @id @default(cuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id])
  authorId        String
  author          User       @relation("PostAuthor", fields: [authorId], references: [id])
  title           String?
  content         String     @db.Text
  imageUrl        String?
  videoUrl        String? // link externo (YouTube/Vimeo) — mutuamente exclusivo com imageUrl na prática, mas não travado no schema
  status          PostStatus @default(PENDING_APPROVAL)
  reviewedById    String?
  reviewedBy      User?      @relation("PostReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Moderação — Master e o próprio Autor podem ocultar (reversível, some do
  // mural mas fica no banco) ou excluir (hard delete, ver DELETE /api/company/posts/[id]).
  isHidden   Boolean   @default(false)
  hiddenById String?
  hiddenBy   User?     @relation("PostHiddenBy", fields: [hiddenById], references: [id])
  hiddenAt   DateTime?

  likes     PostLike[]
  comments  PostComment[]
  reactions PostReaction[]

  @@index([companyId])
  @@index([status])
}

// Reação em emoji (distinta do Curtir/PostLike) — 1 emoji por usuário por
// post; trocar a reação faz DELETE + POST (ver app/api/company/posts/[id]/reactions).
model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PostReactionUser", fields: [userId], references: [id])
  emoji     String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PostLikeUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("PostCommentAuthor", fields: [authorId], references: [id])
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId])
}

// Ocorrências operacionais de RH/Financeiro registradas pela Gerente/Master —
// painel de fechamento mensal consultado pelo Master no dia do pagamento.
// `employeeId` é opcional: colaboradores temporários/diaristas sem cadastro
// na plataforma entram apenas com `employeeNameFreeText`.
model Occurrence {
  id                   String                   @id @default(cuid())
  companyId            String
  company              Company                  @relation(fields: [companyId], references: [id])
  employeeId           String?
  employee             User?                    @relation("OccurrenceEmployee", fields: [employeeId], references: [id])
  employeeNameFreeText String? // usado quando employeeId é nulo (temporário/diarista)
  type                 OccurrenceType
  // Preenchido só quando type = CUSTOM — tipo configurável pela empresa (ver OccurrenceTypeConfig)
  customTypeId         String?
  customType           OccurrenceTypeConfig?    @relation(fields: [customTypeId], references: [id])
  date                 DateTime                 @default(now())
  value                Decimal?                 @db.Decimal(10, 2) // valor unitário (R$ ou equivalente em horas)
  quantity             Decimal                  @default(1) @db.Decimal(6, 2) // multiplicador (ex: dias, horas)
  total                Decimal?                 @db.Decimal(10, 2) // value * quantity, calculado no servidor
  paymentMethod        OccurrencePaymentMethod?
  paymentStatus        OccurrencePaymentStatus  @default(PENDING)
  description          String?                  @db.Text
  attachmentUrl        String? // obrigatório para ADVERTENCIA, ATESTADO e DISPENSADO
  discountWaived       Boolean                  @default(false) // FALTA abonada por ATESTADO em até 24h
  createdById          String
  createdBy            User                     @relation("OccurrenceCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime                 @default(now())

  // Preenchido só quando esta Occurrence (type=META) foi gerada pela
  // distribuição automática de prêmio de Meta batida (ver lib/goal-rewards.ts)
  // — permite que excluir a ocorrência estorne o GoalPayout correspondente.
  goalPayout GoalPayout?

  @@index([companyId])
  @@index([employeeId])
  @@index([type])
  @@index([date])
}

// Tipo de ocorrência configurável pela empresa (Gerente/Master) — complementa
// os tipos fixos do enum OccurrenceType. Registrado com type=CUSTOM e
// customTypeId apontando para cá (ver app/api/company/occurrences). `kind`
// decide qual campo de impacto é aplicado no lançamento:
//   POINTS        -> pointsImpact (via awardXp, reason MANUAL_ADJUSTMENT)
//   SALARY        -> salaryImpactType + salaryImpactValue (mesmo tratamento de value/quantity/total já usado nos tipos fixos)
//   HOURS_BANK    -> hoursBankImpactMinutes * quantity, aplicado em EmployeeProfile.bankOfHoursMinutes
//   INFORMATIONAL -> nenhum efeito, só fica no histórico
model OccurrenceTypeConfig {
  id        String               @id @default(cuid())
  companyId String
  company   Company              @relation(fields: [companyId], references: [id])
  name      String
  kind      OccurrenceImpactKind

  pointsImpact           Int?
  salaryImpactType       OccurrenceSalaryImpactType?
  salaryImpactValue      Decimal?                    @db.Decimal(10, 2)
  hoursBankImpactMinutes Int?

  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation("OccurrenceTypeConfigCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  occurrences Occurrence[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Nota diária da Gerente para cada Colaborador — 1 por dia/pessoa. Justifica-
// tiva obrigatória fora da faixa neutra (-1 a 1), aplicada em código na rota.
model DailyEvaluation {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  employeeId    String
  employee      User     @relation("DailyEvaluationEmployee", fields: [employeeId], references: [id])
  date          DateTime // normalizada para 00:00 do dia avaliado
  score         Decimal  @db.Decimal(3, 1) // pode ser negativa
  justification String?  @db.Text
  evaluatedById String
  evaluatedBy   User     @relation("DailyEvaluationEvaluator", fields: [evaluatedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([employeeId, date])
  @@index([companyId])
  @@index([date])
}

// Programa Interno de Colaboradores — no MÁXIMO 1 por empresa (@@unique
// companyId). Reúne o termo de aceite, o período de avaliação e as regras de
// pontuação/bônus que antes viviam hardcoded em lib/gamification.ts.
model InternalProgram {
  id           String  @id @default(cuid())
  companyId    String  @unique
  company      Company @relation(fields: [companyId], references: [id])
  title        String
  description  String? @db.Text
  imageUrl     String? // imagem representativa do programa
  pdfUrl       String? // anexo PDF com regras completas
  videoUrl     String? // vídeo institucional (URL externa — YouTube/Vimeo)
  termsContent String? @db.Text // termo de aceite (texto/markdown simples)

  measurementPeriod MeasurementPeriod @default(MONTHLY)

  // Pontuação Base mensal — todo colaborador (inclusive recém-contratado)
  // começa o dia 1º de cada mês com esta pontuação cheia (ver
  // lib/gamification.ts#getMonthlyServiceScore, que soma XpEntry do mês a
  // partir desta base).
  basePoints Int @default(100)

  // Regras de pontuação (aplicadas em lib/gamification.ts em vez de constantes fixas)
  pointsPunctualEntry      Int @default(5) // GPS/ponto batido dentro do horário
  pointsChecklistOnTime    Int @default(5)
  pointsChecklistLate      Int @default(-3) // entregue, porém fora do prazo
  pointsChecklistFail      Int @default(-5) // devolvido/reprovado ou não entregue
  pointsChecklistExtraTask Int @default(8) // secundário ajudou numa tarefa do principal presente (bônus, ver Checklist.isExtraTask)
  pointsAbsenceJustified   Int @default(0) // FALTA abonada por ATESTADO em até 24h
  pointsAbsenceUnjustified Int @default(-15) // FALTA sem ATESTADO
  pointsOccurrence         Int @default(-10) // ADVERTENCIA/demais ocorrências

  // Tolerância do Ponto Digital — margem (min) antes/depois do horário
  // previsto que NÃO gera hora extra nem penalidade de atraso; acima dela,
  // desconta pointsLatePenalty automaticamente (ver app/api/company/timeclock).
  lateToleranceMinutes Int @default(15)
  pointsLatePenalty    Int @default(-5)

  // Bônus de eficiência: colaborador com % de checklist no prazo >= minEfficiencyPercent
  // no período de medição recebe efficiencyBonusAmount (calculado em lib/gamification.ts)
  minEfficiencyPercent  Int      @default(90)
  efficiencyBonusAmount Decimal? @db.Decimal(10, 2)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levels          InternalLevelRule[]
  termAcceptances EmployeeTermAcceptance[]
  serviceFeeTiers InternalServiceFeeTier[]
}

// Faixa/range de pontuação final do mês (apuração de 30 dias) -> impacto na
// Taxa de Serviço/Salário — ranges [minPoints, maxPoints] cobrindo toda a
// régua (perda, neutro, bônus são só ranges com efeito negativo/zero/positivo),
// ver lib/gamification.ts#getServiceFeeAdjustment. `kind` decide se a faixa
// usa percentage, fixedAmount ou ambos — sinal negativo = redução, positivo = aumento.
model InternalServiceFeeTier {
  id                String          @id @default(cuid())
  internalProgramId String
  internalProgram   InternalProgram @relation(fields: [internalProgramId], references: [id], onDelete: Cascade)
  minPoints         Int
  maxPoints         Int
  kind              BenefitType     @default(PERCENTAGE)
  percentage        Decimal?        @db.Decimal(6, 2) // pode ser negativo
  fixedAmount       Decimal?        @db.Decimal(10, 2) // pode ser negativo
  createdAt         DateTime        @default(now())

  @@index([internalProgramId])
}

// Régua de cargos do Programa Interno (Trainee -> Junior -> ... -> Supervisor,
// nomes livres por empresa). `pointsRequired` é RELATIVO ao nível — pontos que
// o colaborador precisa acumular NESTE cargo para ser promovido ao próximo;
// EmployeeProfile.xpPoints zera a cada promoção (ver regra de mudança de cargo).
model InternalLevelRule {
  id                    String          @id @default(cuid())
  internalProgramId     String
  internalProgram       InternalProgram @relation(fields: [internalProgramId], references: [id], onDelete: Cascade)
  name                  String
  description           String?         @db.Text
  order                 Int             @default(0)
  pointsRequired        Int
  salaryIncreasePercent Decimal?        @db.Decimal(5, 2)
  imageUrl              String? // ícone customizado (upload) — sobrepõe medalIcon quando presente
  medalIcon             MedalIcon       @default(GOLD)
  bonusDescription      String?
  bonusAmount           Decimal?        @db.Decimal(10, 2)
  badgeColorHex         String          @default("#F58220")

  // Benefício da promoção — % de aumento salarial (salaryIncreasePercent),
  // Bônus Fixo (bonusAmount) ou Ambos, conforme benefitType.
  benefitType BenefitType @default(PERCENTAGE)

  // Período de mensuração do cargo — se o colaborador não sustentar o
  // desempenho (pointsRequired) nesse prazo, o cargo é reavaliado/rebaixado
  // (ver lib/gamification.ts#checkCareerDowngrades). ALL_TIME = vitalício.
  measurementUnit  MeasurementUnit @default(ALL_TIME)
  measurementValue Int? // combinado com measurementUnit (DAYS ou MONTHS)

  // Tempo mínimo (meses) que o colaborador precisa permanecer neste cargo,
  // contado a partir de EmployeeProfile.currentInternalLevelSince, antes de
  // ficar elegível para a próxima promoção — combinado com pointsRequired do
  // PRÓXIMO nível (ver app/api/company/gamification/promotion-eligible).
  minTenureMonths Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees           EmployeeProfile[]
  pendingPromotionFor EmployeeProfile[] @relation("PendingPromotion")

  @@unique([internalProgramId, order])
  @@index([internalProgramId])
}

// Confirmação de aceite do Termo do Programa Interno no primeiro acesso do colaborador.
model EmployeeTermAcceptance {
  id                String          @id @default(cuid())
  employeeId        String
  employee          User            @relation("EmployeeTermAcceptanceUser", fields: [employeeId], references: [id])
  internalProgramId String
  internalProgram   InternalProgram @relation(fields: [internalProgramId], references: [id], onDelete: Cascade)
  acceptedAt        DateTime        @default(now())
  ipAddress         String?

  @@unique([employeeId, internalProgramId])
}

// Confirmação de aceite do Termo do Programa de Parceiros no primeiro acesso do parceiro.
model PartnerTermAcceptance {
  id         String   @id @default(cuid())
  partnerId  String
  partner    User     @relation("PartnerTermAcceptanceUser", fields: [partnerId], references: [id])
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  acceptedAt DateTime @default(now())
  ipAddress  String?

  @@unique([partnerId, programId])
}

// Setor da empresa (Cozinha, Atendimento, Recepção...) — usado para agrupar
// colaboradores e para metas com scope=SECTOR.
model Sector {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees            EmployeeProfile[]
  goals                Goal[]
  registrationLinks    PublicRegistrationLink[]
  registrationRequests PublicRegistrationRequest[]
  internalMessages     InternalMessage[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Meta escalonada — por Empresa, Setor ou Colaborador individual, em qualquer
// período. Substitui o antigo RevenueGoalTier (fixo, só diário, só empresa).
model Goal {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  scope       GoalScope
  sectorId    String? // obrigatório quando scope = SECTOR
  sector      Sector?    @relation(fields: [sectorId], references: [id])
  employeeId  String? // obrigatório quando scope = EMPLOYEE
  employee    User?      @relation("GoalEmployee", fields: [employeeId], references: [id])
  period      GoalPeriod
  name        String
  active      Boolean    @default(true)
  startDate   DateTime   @default(now())
  endDate     DateTime?
  createdById String
  createdBy   User       @relation("GoalCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tiers   GoalTier[]
  records GoalRecord[]
  payouts GoalPayout[]

  @@index([companyId])
  @@index([sectorId])
  @@index([employeeId])
}

// Faixa de bônus escalonado de uma Goal (ex: R$5k -> R$30, R$7k -> R$50, R$10k -> R$70).
model GoalTier {
  id           String  @id @default(cuid())
  goalId       String
  goal         Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  order        Int
  targetAmount Decimal @db.Decimal(10, 2)
  bonusAmount  Decimal @db.Decimal(10, 2) // valor do bônus em dinheiro (rewardType = CASH) — também usado como referência de custo quando PHYSICAL_REWARD

  // Tipo de recompensa ao bater esta faixa — CASH credita bonusAmount na
  // carteira; PHYSICAL_REWARD concede um item da Loja de Prêmios
  // (rewardCatalogItemId) ou um prêmio livre descrito em rewardLabel.
  rewardType          GoalRewardType     @default(CASH)
  rewardCatalogItemId String?
  rewardCatalogItem   RewardCatalogItem? @relation(fields: [rewardCatalogItemId], references: [id])
  rewardLabel         String? // ex: "Jantar Especial", "Folga Extra" — usado quando PHYSICAL_REWARD sem item de catálogo
  createdAt           DateTime           @default(now())

  payouts GoalPayout[]

  @@unique([goalId, order])
}

// Resultado diário reportado para uma Goal — fechamento obrigatório da
// Gerente/Master na última hora do expediente (metas COMPANY sincronizam
// automaticamente com ShiftClosing.revenueAmount do mesmo dia; SECTOR/
// EMPLOYEE são reportadas à parte). Consolidações mensais/trimestrais/etc
// são a SOMA destes registros diários no período — nunca um valor solto.
model GoalRecord {
  id           String   @id @default(cuid())
  goalId       String
  goal         Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date         DateTime // normalizado para 00:00
  amount       Decimal  @db.Decimal(10, 2)
  receiptUrl   String?
  reportedById String
  reportedBy   User     @relation("GoalRecordReportedBy", fields: [reportedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([goalId, date])
  @@index([goalId])
}

// Extrato de pontos de XP — cada lançamento também ajusta
// EmployeeProfile.xpPoints (mantido em transação, ver lib/gamification.ts).
model XpEntry {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  employeeId String
  employee   User     @relation("XpEntryEmployee", fields: [employeeId], references: [id])
  reason     XpReason
  points     Int // negativo em punições/resgates
  sourceId   String? // id da entidade de origem (TimeEntry, Checklist, DailyEvaluation, Occurrence...)
  note       String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([employeeId])
}

model RewardCatalogItem {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?  @db.Text
  costXp      Int
  imageUrl    String?
  stock       Int? // null = ilimitado
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RewardRedemption[]
  goalTiers   GoalTier[]

  @@index([companyId])
}

model RewardRedemption {
  id           String                 @id @default(cuid())
  companyId    String
  company      Company                @relation(fields: [companyId], references: [id])
  itemId       String
  item         RewardCatalogItem      @relation(fields: [itemId], references: [id])
  employeeId   String
  employee     User                   @relation("RewardRedemptionEmployee", fields: [employeeId], references: [id])
  costXp       Int
  status       RewardRedemptionStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?                  @relation("RewardRedemptionReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime               @default(now())

  @@index([companyId])
  @@index([employeeId])
}

// Notificação em-app (sino do dashboard). O melhor esforço de email (Resend)
// e o link de WhatsApp (wa.me, sem API paga — mesmo padrão de
// lib/promotion-share.ts) são disparados no momento da criação por
// lib/notifications.ts; esta linha é o registro persistente/fonte da verdade
// para o sino, independente desses canais terem funcionado ou não.
model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType @default(GENERIC)
  title       String
  message     String           @db.Text
  linkUrl     String? // rota interna para onde o clique deve levar (ex: /admin/cadastros?tab=approvals)
  emailSent   Boolean          @default(false)
  whatsappUrl String? // link wa.me pronto, oferecido na UI como fallback manual
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([userId, readAt])
}

// Fechamento diário obrigatório de expediente — 1 registro por empresa/dia.
// Nasce PENDING_GERENTE; se ninguém fechar até Company.shiftClosingDeadline,
// a rota de leitura sinaliza PENDING_MASTER para o painel do Master assumir
// (isMasterOverride=true quando ele efetivamente conclui).
model ShiftClosing {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id])
  date             DateTime // normalizado para 00:00 do dia do fechamento
  revenueAmount    Decimal?           @db.Decimal(10, 2)
  receiptUrl       String? // foto do comprovante de fechamento do caixa
  summary          String?            @db.Text
  status           ShiftClosingStatus @default(PENDING_GERENTE)
  isMasterOverride Boolean            @default(false)
  // Fechado depois do shiftClosingDeadline da empresa — independe de quem
  // fechou (Gerente ou Master); `isMasterOverride` só é true quando foi
  // especificamente o Master que fechou/corrigiu. Dispara aviso ao Master.
  isLate           Boolean            @default(false)
  closedById       String?
  closedBy         User?              @relation("ShiftClosingClosedBy", fields: [closedById], references: [id])
  closedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([companyId, date])
  @@index([companyId])
  @@index([status])
}

// Controle mensal da "1 Folga Adicional por Mês" (ver EmployeeProfile.
// hasExtraMonthlyDayOff) — 1 registro por colaborador/mês. Se `used` continuar
// false ao fim do mês, o Financeiro/RH usa `paidAmount` (via GoalPayout ou
// lançamento manual) para pagar a folga não gozada junto à folha.
model MonthlyDayOffRecord {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  month             String // "AAAA-MM"
  used              Boolean         @default(false)
  usedDate          DateTime?
  paidOut           Boolean         @default(false)
  paidAmount        Decimal?        @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([employeeProfileId, month])
  @@index([companyId])
}

// Comunicação Interna — mensagem formal de um membro da equipe para um Setor
// (entregue aos responsáveis, ver EmployeeProfile.isSectorCommunicationResponsible),
// uma Função/Role inteira, ou um Colaborador específico. Distinta do Ticket
// (que é sempre endereçado à Tribuss/Admin da plataforma).
model InternalMessage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  senderId  String
  sender    User    @relation("InternalMessageSender", fields: [senderId], references: [id])

  recipientType       InternalMessageRecipientType
  recipientSectorId   String?
  recipientSector     Sector?                      @relation(fields: [recipientSectorId], references: [id])
  recipientRole       Role?
  recipientEmployeeId String?
  recipientEmployee   User?                        @relation("InternalMessageRecipientEmployee", fields: [recipientEmployeeId], references: [id])

  subject        String
  body           String                @db.Text
  attachmentUrls String[]
  status         InternalMessageStatus @default(SENT)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  replies InternalMessageReply[]

  @@index([companyId])
  @@index([senderId])
  @@index([status])
}

model InternalMessageReply {
  id        String          @id @default(cuid())
  messageId String
  message   InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation("InternalMessageReplyAuthor", fields: [authorId], references: [id])
  body      String          @db.Text
  createdAt DateTime        @default(now())

  @@index([messageId])
}

// Registro de quitação de um bônus/prêmio de Meta atingida — criado pela
// Gerente/Master no Módulo Financeiro (aba "Registro de Quitação"),
// atualizando o saldo do colaborador como pago (ver app/company/financeiro).
model GoalPayout {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id])
  goalId     String
  goal       Goal             @relation(fields: [goalId], references: [id])
  goalTierId String?
  goalTier   GoalTier?        @relation(fields: [goalTierId], references: [id])
  employeeId String
  employee   User             @relation("GoalPayoutEmployee", fields: [employeeId], references: [id])
  period     String // "AAAA-MM" — competência do bônus
  amount     Decimal          @db.Decimal(10, 2)
  rewardType GoalRewardType   @default(CASH)
  status     GoalPayoutStatus @default(PAID)
  paidById   String
  paidBy     User             @relation("GoalPayoutPaidBy", fields: [paidById], references: [id])
  paidAt     DateTime         @default(now())
  note       String?
  createdAt  DateTime         @default(now())

  // Ocorrência (type=META) irmã, criada só pela distribuição automática —
  // null nos lançamentos manuais via /company/financeiro. Excluir essa
  // Occurrence estorna este GoalPayout (ver DELETE /api/company/occurrences/[id]).
  occurrenceId String?     @unique
  occurrence   Occurrence? @relation(fields: [occurrenceId], references: [id])

  // Evita distribuir a mesma faixa batida duas vezes pro mesmo colaborador no
  // mesmo período (idempotência da distribuição automática — lançamentos
  // manuais não preenchem goalTierId, então não colidem com esta regra).
  @@unique([goalId, goalTierId, employeeId, period])
  @@index([companyId])
  @@index([employeeId])
  @@index([goalId])
}

// Espelho de ponto — pedido de justificativa (atestado, esquecimento etc.)
// para um dia específico, revisado pela Gerente/Master.
model TimeEntryJustification {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  employeeId      String
  employee        User                @relation("TimeJustificationEmployee", fields: [employeeId], references: [id])
  date            DateTime
  reason          String              @db.Text
  documentUrl     String? // atestado médico digitalizado, quando houver
  status          JustificationStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?               @relation("TimeJustificationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())

  @@index([companyId])
  @@index([employeeId])
}

// Tipo de variação de ponto sugerida automaticamente pelo relógio — LATE_CHECKIN
// (entrada), CHECKOUT_VARIANCE (saiu mais cedo/mais tarde) e BREAK_OVERAGE
// (intervalo além do permitido). Ver lib/timeclock-adjustments.ts.
enum TimeclockAdjustmentKind {
  LATE_CHECKIN
  CHECKOUT_VARIANCE
  BREAK_OVERAGE
}

// Decisão da Gerente/Master sobre uma variação de ponto calculada pelo
// sistema — nada é aplicado ao colaborador até esta confirmação acontecer no
// Fechamento do dia (ver app/api/company/shift-closing/timeclock-adjustments).
// `@@unique` garante que cada variação só é perguntada uma vez.
model TimeclockAdjustmentReview {
  id              String                  @id @default(cuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id])
  employeeId      String
  employee        User                    @relation("TimeclockAdjustmentEmployee", fields: [employeeId], references: [id])
  date            DateTime // normalizado para 00:00 — dia a que a variação se refere
  kind            TimeclockAdjustmentKind
  computedMinutes Int // sugerido pelo relógio — negativo = déficit/atraso, positivo = crédito
  computedPoints  Int // sugerido — negativo = penalidade, positivo = bônus
  applied         Boolean // true = Gerente confirmou e o ajuste foi lançado; false = perdoado/descartado
  justification   String?                 @db.Text // obrigatório quando o resultado aplicado é negativo pro colaborador
  reviewedById    String
  reviewedBy      User                    @relation("TimeclockAdjustmentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime                @default(now())

  @@unique([employeeId, date, kind])
  @@index([companyId])
  @@index([employeeId])
}
